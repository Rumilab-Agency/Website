# Copy to .env.local for local dev, and add the same variables in Vercel
# (Project → Settings → Environment Variables) for production.
RESEND_API_KEY=re_xxxxxxxxxxxx
ENQUIRY_TO=contact@rumilab.org
# Must be on a domain verified in Resend. Before verifying, use
# "RumiLab Website <onboarding@resend.dev>" (only delivers to your Resend account email).
ENQUIRY_FROM=RumiLab Website <website@rumilab.org>
